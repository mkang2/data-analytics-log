      "source": [
        "#movies and tv shows by top countries\n",
        "df_country = df.dropna(subset=[\"country\"]).copy()\n",
        "\n",
        "df_country[\"country\"] = df_country[\"country\"].str.split(\", \")\n",
        "\n",
        "df_country = df_country.explode(\"country\")\n",
        "\n",
        "country_type = pd.crosstab(\n",
        "    df_country[\"country\"],\n",
        "    df_country[\"type\"]\n",
        ")\n",
        "\n",
        "top_10 = country_type.sum(axis=1).nlargest(10).index\n",
        "\n",
        "top_10_comparison = country_type.loc[top_10]\n",
        "\n",
        "top_10_comparison.plot(\n",
        "    kind=\"bar\",\n",
        "    figsize=(12, 6),\n",
        "    color=[\"tomato\", \"steelblue\"]\n",
        ")\n",
        "\n",
        "plt.title(\"Movies vs TV Shows by Top 10 Countries\")\n",
        "plt.xlabel(\"Country\")\n",
        "plt.ylabel(\"Number of Titles\")\n",
        "plt.xticks(rotation=45)\n",
