1) Customer Spending Analysis
SELECT
    customer_id,
    customer_name,
    COALESCE(city, 'Unknown') AS city,
    SUM(quantity * unit_price) AS total_spending,
    CASE
        WHEN SUM(quantity * unit_price) >= 2000
            THEN 'High Value'
        WHEN SUM(quantity * unit_price) >= 1000
            THEN 'Medium Value'
        ELSE 'Low Value'
    END AS customer_segment
FROM sales
WHERE order_status = 'Completed'
GROUP BY customer_id, customer_name, city
ORDER BY total_spending DESC;

2) Monthly Spending
SELECT SUBSTRING(order_date, 6, 2) AS month, 
SUM(quantity * unit_price) AS monthly_revenue
FROM sales
WHERE order_status = 'Completed'
GROUP BY month
ORDER BY monthly_revenue DESC;

3) Repeat customers (more than 4 times)
SELECT customer_id, customer_name
FROM sales
WHERE order_status = 'Completed'
GROUP BY customer_id, customer_name
HAVING COUNT(DISTINCT order_id) > 4;

4) Top products
SELECT
    product_name,
    SUM(quantity * unit_price) AS revenue,
    RANK() OVER (
        ORDER BY SUM(quantity * unit_price) DESC
    ) AS product_rank
FROM sales
WHERE order_status = 'Completed'
GROUP BY product_name;

5) Customer Ranking
WITH customer_totals AS (
    SELECT
        customer_id,
        customer_name,
        SUM(quantity * unit_price) AS spending
    FROM sales
    WHERE order_status = 'Completed'
    GROUP BY customer_id, customer_name
)
SELECT
    *,
    RANK() OVER (ORDER BY spending DESC) AS spending_rank
FROM customer_totals;

6) Revenue trends
WITH monthly AS (
    SELECT
        SUBSTRING(order_date, 6, 2) AS month,
        SUM(quantity * unit_price) AS revenue
    FROM sales
    WHERE order_status = 'Completed'
    GROUP BY month
)
SELECT
    month,
    revenue,
    SUM(revenue) OVER (
        ORDER BY month
    ) AS running_revenue,
    AVG(revenue) OVER () AS average_monthly_revenue,
    LAG(revenue) OVER (
        ORDER BY month
    ) AS previous_month_revenue,
    LEAD(revenue) OVER (
        ORDER BY month
    ) AS next_month_revenue
FROM monthly
ORDER BY month;

