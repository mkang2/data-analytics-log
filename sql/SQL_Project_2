CREATE TABLE sales (
    sale_id INT PRIMARY KEY,
    order_id INT,
    order_date DATE,
    customer_id INT,
    customer_name VARCHAR(100),
    city VARCHAR(50),
    product_name VARCHAR(100),
    category VARCHAR(50),
    quantity INT,
    unit_price DECIMAL(10,2),
    order_status VARCHAR(20)
);

