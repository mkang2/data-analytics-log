Queries
1) Find the 5 highest rated books
SELECT title
FROM books 
ORDER BY rating DESC
LIMIT 5;

2) Find all books written in Spanish or French
SELECT title
FROM books 
WHERE language IN ('Spanish', 'French')

3) Find all books whose title contains the word "the" sorted alphabetically
SELECT title
FROM books 
WHERE title LIKE '%the%'
ORDER BY title;

4) Find books published between 2015 and 2020
SELECT title
FROM books 
WHERE published_year BETWEEN 2015 and 2020;

5) Find books where availability is unknown
SELECT title
FROM books
WHERE available IS NULL;

6) Find all distinct genres
SELECT DISTINCT genre
FROM books;

7) Find the total number of books and the average rating of all books.
SELECT COUNT(title), AVG(rating)
FROM books;

8) Find the total number of times all books have been borrowed.
SELECT SUM(borrowed_count)
FROM books;

9) Find the highest rating and lowest rating among all books.
SELECT 
    MAX(rating) AS highest_rating,
    MIN(rating) AS lowest_rating
FROM books;

10) Group the books by genre and find the number of books and average rating for each genre. Only display genres that have at least 5 books, and sort them by average rating from highest to lowest.
SELECT 
    genre,
    COUNT(*) AS book_count,
    AVG(rating) AS average_rating
FROM books
GROUP BY genre
HAVING COUNT(*) >= 5
ORDER BY average_rating DESC;
